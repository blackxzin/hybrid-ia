LOCAL_RESPONSE_RESERVE_TOKENS=1024
LOCAL_CONTEXT_SAFETY_TOKENS=256
ROUTER9_BASE_URL=http://127.0.0.1:20128/v1
ROUTER9_ENABLED=true
ROUTER9_API_KEY=
